@model UrlShortner.Web.Models.VerifyOtpViewModel
@{
    var isResetPassword = Model.Purpose == "ResetPassword";
    ViewData["Title"] = isResetPassword ? "Reset Password" : "Verify Code";
}

<div class="container">
    <div class="row justify-content-center mt-5">
        <div class="col-lg-5 col-md-7">

            @* HEADER ICON *@
            <div class="text-center mb-4">
                <div class="otp-icon-wrapper">
                    <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        @if (isResetPassword)
                        {
                            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                        }
                        else
                        {
                            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                            <polyline points="22,6 12,13 2,6"></polyline>
                        }
                    </svg>
                </div>
                <h2 style="font-weight: 700; margin-top: 0.8rem;">
                    @(isResetPassword ? "Reset Password" : "Verify Your Account")
                </h2>
                <p class="text-muted">
                    Your verification code for<br />
                    <strong style="color: var(--text-primary);">@Model.Email</strong>
                </p>
            </div>

            @* INFO ALERT *@
            @if (ViewBag.Message != null)
            {
                <div class="alert alert-info fade-in text-center">@ViewBag.Message</div>
            }

            @if (ViewBag.DevOtp != null)
            {
                <div style="background: var(--bg-input); border: 1px solid var(--border); border-radius: 10px; padding: 1rem; text-align: center; margin-bottom: 1rem;">
                    <p style="font-size: 0.8rem; color: var(--text-muted); margin-bottom: 0.5rem;">Your verification code</p>
                    <code style="font-size: 2rem; font-weight: 700; color: var(--accent); letter-spacing: 10px;">@ViewBag.DevOtp</code>
                </div>
            }

            @* OTP CARD *@
            <div class="card otp-card">
                <div class="card-body p-4">
                    <form asp-action="VerifyOtp" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <input type="hidden" asp-for="Email" />
                        <input type="hidden" asp-for="Purpose" />

                        <div class="mb-4">
                            <label asp-for="Otp" class="form-label text-center d-block" style="font-weight: 600; font-size: 0.9rem; text-transform: uppercase; letter-spacing: 1px;">
                                @(isResetPassword ? "Reset Code" : "Verification Code")
                            </label>
                            <input asp-for="Otp"
                                   class="form-control otp-input"
                                   placeholder="000000"
                                   maxlength="6"
                                   autocomplete="one-time-code"
                                   inputmode="numeric" />
                            <span asp-validation-for="Otp" class="text-danger small text-center d-block mt-1"></span>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 btn-lg">
                            @(isResetPassword ? "Verify Reset Code" : "Verify & Continue")
                        </button>
                    </form>

                    <div class="text-center mt-3">
                        <p class="text-muted small mb-0">
                            @if (isResetPassword)
                            {
                                <span>Didn't receive the code? <a asp-action="ForgotPassword">Send again</a></span>
                            }
                            else
                            {
                            }
                        </p>
                        <p class="text-muted small mt-1">
                            ⏱ Code expires in 10 minutes
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var otpInput = document.querySelector('.otp-input');
            if (otpInput) {
                @if (ViewBag.DevOtp != null)
                    {
                        <text>otpInput.value = '@ViewBag.DevOtp';</text>
                }
                    otpInput.focus();
            }
        });
    </script>
}