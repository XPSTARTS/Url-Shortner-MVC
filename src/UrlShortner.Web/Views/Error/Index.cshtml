@* Views/Error/Index.cshtml *@
@{
    ViewData["Title"] = $"Error {ViewBag.StatusCode}";
    Layout = "_Layout";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center">
            <h1 class="display-1 text-muted">@ViewBag.StatusCode</h1>
            <h2 class="mb-4">@ViewBag.Message</h2>
            <p class="text-muted mb-4">Something went wrong. Please try again or return to homepage.</p>
            <a href="/" class="btn btn-primary">Go Home</a>
        </div>
    </div>
</div>