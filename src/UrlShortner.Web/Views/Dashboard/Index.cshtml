@model List<UrlShortner.Domain.Entities.ShortUrl>
@{
    ViewData["Title"] = "Dashboard";
    var baseUrl = $"{Context.Request.Scheme}://{Context.Request.Host}";
}

<div class="container page-enter">

    @* HEADER *@
    <div class="d-flex flex-wrap justify-content-between align-items-center mt-4 mb-4">
        <div>
            <h1 class="mb-1" style="font-weight: 700; font-size: 1.8rem;">Dashboard</h1>
            <p class="text-muted mb-0" style="font-size: 0.9rem;">Overview of your shortened links</p>
        </div>
        <div class="d-flex gap-2 mt-2 mt-md-0">
            <a asp-controller="Dashboard" asp-action="Profile" class="btn btn-outline-secondary btn-sm">Profile</a>
            <a asp-controller="Url" asp-action="Create" class="btn btn-primary btn-sm">New Link</a>
        </div>
    </div>

    @* SUCCESS MESSAGE *@
    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success fade-in">@TempData["Message"]</div>
    }

    @* STAT CARDS *@
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card stat-card stagger-1">
                <div class="card-body">
                    <p class="stat-label">Total Links</p>
                    <p class="stat-value">@ViewBag.TotalUrls</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card stat-card stagger-2">
                <div class="card-body">
                    <p class="stat-label">Total Clicks</p>
                    <p class="stat-value">@((ViewBag.TotalClicks as long?)?.ToString("N0") ?? "0")</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card stat-card stagger-3">
                <div class="card-body">
                    <p class="stat-label">Active Links</p>
                    <p class="stat-value">@ViewBag.ActiveUrls</p>
                </div>
            </div>
        </div>
    </div>

    @* LINKS SECTION *@
    <div class="stagger-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 style="font-size: 1.1rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; color: var(--text-secondary);">Your Links</h2>
            <span class="badge bg-primary" style="font-size: 0.75rem;">@Model.Count links</span>
        </div>

        @if (Model.Any())
        {
            <div class="links-grid">
                @foreach (var url in Model)
                {
                    <div class="link-card card">
                        <div class="card-body p-0">
                            <div class="link-card-inner">
                                @* LEFT: Link info *@
                                <div class="link-info">
                                    <a href="@baseUrl/@url.ShortCode" target="_blank" class="link-code">
                                        /@url.ShortCode
                                    </a>
                                    <span class="link-url" title="@url.OriginalUrl">@TruncateUrl(url.OriginalUrl)</span>
                                </div>

                                @* RIGHT: Meta + Actions *@
                                <div class="link-meta">
                                    <div class="link-stats">
                                        <span class="link-stat" title="Clicks">
                                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                                            @url.ClickCount.ToString("N0")
                                        </span>
                                        <span class="link-stat" title="Created">
                                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                                            @url.CreatedAt.ToString("MMM dd")
                                        </span>
                                        @if (url.ExpiresAt.HasValue)
                                        {
                                            <span class="link-stat link-expires" title="Expires">
                                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                                                @url.ExpiresAt.Value.ToString("MMM dd")
                                            </span>
                                        }
                                    </div>
                                    <div class="link-actions">
                                        <button onclick="copyUrl('@baseUrl/@url.ShortCode', this)" class="btn-action" title="Copy link">
                                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
                                        </button>
                                        <form asp-action="Delete" method="post" onsubmit="return confirm('Delete this link?');">
                                            <input type="hidden" name="id" value="@url.Id" />
                                            <button type="submit" class="btn-action btn-action-danger" title="Delete link">
                                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="card">
                <div class="card-body text-center py-5">
                    <div style="font-size: 3rem; margin-bottom: 1rem; opacity: 0.3;">
                        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg>
                    </div>
                    <h3 style="font-weight: 600;">No links yet</h3>
                    <p class="text-muted">Create your first short link to get started</p>
                    <a asp-controller="Url" asp-action="Create" class="btn btn-primary mt-2">Create Link</a>
                </div>
            </div>
        }
    </div>
</div>

@functions {
    string TruncateUrl(string url)
    {
        if (string.IsNullOrEmpty(url)) return "";
        try
        {
            var uri = new Uri(url);
            var display = uri.Host + uri.AbsolutePath;
            if (display.Length > 35) display = display.Substring(0, 35) + "...";
            return display;
        }
        catch { return url.Length > 40 ? url.Substring(0, 40) + "..." : url; }
    }
}

@section Scripts {
    <script>
        function copyUrl(text, btn) {
            navigator.clipboard.writeText(text);
            btn.style.color = 'var(--success)';
            btn.style.borderColor = 'var(--success)';
            setTimeout(() => {
                btn.style.color = '';
                btn.style.borderColor = '';
            }, 1500);
        }
    </script>
}