@model UrlShortner.Web.Models.ShortenUrlViewModel
@{
    ViewData["Title"] = "URL Shortner";
}

<div class="container">

    @* HERO SECTION *@
    <div class="hero-section">
        <div class="hero-icon">🔗</div>
        <h1 class="hero-title">
            Shorten Your <span>Links</span>
        </h1>
        <p class="hero-subtitle">
            Transform long URLs into clean, trackable short links in seconds.
            Fast, secure, and free.
        </p>
    </div>

    @* SHORTEN FORM *@
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shorten-card glow-pulse">
                <div class="card-body p-4">
                    <form asp-controller="Url" asp-action="Create" method="post">
                        <div class="mb-3">
                            <div class="input-group input-group-lg">
                                <span class="input-group-text">🔗</span>
                                <input asp-for="OriginalUrl" class="form-control"
                                       placeholder="Paste your long URL here..." />
                            </div>
                            <span asp-validation-for="OriginalUrl" class="text-danger small"></span>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <div class="input-group">
                                    <span class="input-group-text">shortner.com/</span>
                                    <input asp-for="CustomAlias" class="form-control"
                                           placeholder="custom-alias" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <select asp-for="ExpiryDays" class="form-select">
                                    <option value="">Expires: Never</option>
                                    <option value="1">Expires: 1 Day</option>
                                    <option value="7">Expires: 7 Days</option>
                                    <option value="30">Expires: 30 Days</option>
                                    <option value="90">Expires: 90 Days</option>
                                </select>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-primary btn-lg w-100">
                            ✂️ Shorten URL
                        </button>
                    </form>
                </div>
            </div>

            @if (!User.Identity!.IsAuthenticated)
            {
                <p class="text-center mt-3">
                    <a asp-controller="Auth" asp-action="Register" class="text-muted">
                        Create an account to track your links →
                    </a>
                </p>
            }
        </div>
    </div>

    @* FEATURES SECTION *@
    <div class="features-section">
        <div class="row g-4">
            <div class="col-md-3 col-sm-6">
                <div class="feature-card">
                    <div class="feature-icon">⚡</div>
                    <h4>Lightning Fast</h4>
                    <p>Redis-powered redirects in under 1 millisecond</p>
                </div>
            </div>
            <div class="col-md-3 col-sm-6">
                <div class="feature-card">
                    <div class="feature-icon">📊</div>
                    <h4>Analytics</h4>
                    <p>Track clicks, referrers, and geographic data</p>
                </div>
            </div>
            <div class="col-md-3 col-sm-6">
                <div class="feature-card">
                    <div class="feature-icon">🔒</div>
                    <h4>Secure</h4>
                    <p>2FA authentication with email OTP verification</p>
                </div>
            </div>
            <div class="col-md-3 col-sm-6">
                <div class="feature-card">
                    <div class="feature-icon">🎨</div>
                    <h4>Custom Aliases</h4>
                    <p>Create branded short links that stand out</p>
                </div>
            </div>
        </div>
    </div>

    @* STATS SECTION (static demo) *@
    <div class="stats-section">
        <div class="row g-4">
            <div class="col-4">
                <div class="stat-item">
                    <div class="stat-number">10K+</div>
                    <div class="stat-label">URLs Shortened</div>
                </div>
            </div>
            <div class="col-4">
                <div class="stat-item">
                    <div class="stat-number">50K+</div>
                    <div class="stat-label">Total Clicks</div>
                </div>
            </div>
            <div class="col-4">
                <div class="stat-item">
                    <div class="stat-number">&lt;1ms</div>
                    <div class="stat-label">Redirect Speed</div>
                </div>
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}