<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - URL Shortner</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <nav class="navbar navbar-expand-lg">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">🔗 Shortner</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto gap-1">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Dashboard" asp-action="Index">Dashboard</a>
                        </li>
                        <li class="nav-item">
                            <form asp-controller="Auth" asp-action="Logout" method="post">
                                <button type="submit" class="btn nav-link">Logout</button>
                            </form>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Auth" asp-action="Login">Sign In</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link btn btn-outline-primary btn-sm px-3"
                               asp-controller="Auth" asp-action="Register">Register</a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <main role="main" class="pb-3">
        @RenderBody()
    </main>

    <footer class="footer">
        <div class="container">
            <div class="row g-4">
                <div class="col-md-4">
                    <h5 class="footer-brand">Shortner</h5>
                    <p class="footer-desc">Transform long URLs into clean, trackable short links. Fast, secure, and free.</p>
                </div>
                <div class="col-md-2">
                    <h6 class="footer-heading">Product</h6>
                    <ul class="footer-links">
                        <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                        <li><a asp-controller="Url" asp-action="Create">Shorten URL</a></li>
                        <li><a asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                    </ul>
                </div>
                <div class="col-md-2">
                    <h6 class="footer-heading">Account</h6>
                    <ul class="footer-links">
                        <li><a asp-controller="Auth" asp-action="Login">Sign In</a></li>
                        <li><a asp-controller="Auth" asp-action="Register">Register</a></li>
                        <li><a asp-controller="Dashboard" asp-action="Profile">Profile</a></li>
                    </ul>
                </div>
                <div class="col-md-2">
                    <h6 class="footer-heading">Legal</h6>
                    <ul class="footer-links">
                        <li><a asp-action="Privacy">Privacy Policy</a></li>
                        <li><a asp-action="Terms">Terms of Service</a></li>
                    </ul>
                </div>
                <div class="col-md-2">
                    <h6 class="footer-heading">Links</h6>
                    <ul class="footer-links">
                        <li><a href="/swagger" target="_blank">API Docs</a></li>
                        <li><a href="https://github.com/XPSTARTS/Url-Shortner-MVC" target="_blank">GitHub</a></li>
                    </ul>
                </div>
            </div>
            <div class="footer-bottom">
                <p>&copy; @DateTime.Now.Year Shortner. All rights reserved.</p>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>